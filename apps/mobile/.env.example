# Google OAuth Configuration
# Replace these with your actual values from Google Cloud Console

# Development Environment
DEV_GOOGLE_CLIENT_ID="your-dev-client-id.apps.googleusercontent.com"
DEV_GOOGLE_ANDROID_CLIENT_ID="your-dev-android-client-id.apps.googleusercontent.com"
DEV_GOOGLE_IOS_CLIENT_ID="your-dev-ios-client-id.apps.googleusercontent.com"
DEV_GOOGLE_WEB_CLIENT_ID="your-dev-web-client-id.apps.googleusercontent.com"

# Production Environment
PROD_GOOGLE_CLIENT_ID="your-prod-client-id.apps.googleusercontent.com"
PROD_GOOGLE_ANDROID_CLIENT_ID="your-prod-android-client-id.apps.googleusercontent.com"
PROD_GOOGLE_IOS_CLIENT_ID="your-prod-ios-client-id.apps.googleusercontent.com"
PROD_GOOGLE_WEB_CLIENT_ID="your-prod-web-client-id.apps.googleusercontent.com"

# API URLs
DEV_API_URL="http://localhost:3000"
PROD_API_URL="https://api.yourdomain.com"