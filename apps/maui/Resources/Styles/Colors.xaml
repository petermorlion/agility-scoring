<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary Colors -->
    <Color x:Key="Primary">#4a90e2</Color>
    <Color x:Key="PrimaryLight">#7bb3f0</Color>
    <Color x:Key="PrimaryDark">#3a7bc8</Color>

    <!-- Text Colors -->
    <Color x:Key="TextDark">#333333</Color>
    <Color x:Key="TextMedium">#666666</Color>
    <Color x:Key="TextLight">#999999</Color>
    <Color x:Key="TextWhite">#FFFFFF</Color>

    <!-- Background Colors -->
    <Color x:Key="BackgroundLight">#f5f5f5</Color>
    <Color x:Key="BackgroundWhite">#FFFFFF</Color>
    <Color x:Key="BackgroundDark">#333333</Color>

    <!-- Status Colors -->
    <Color x:Key="Success">#28a745</Color>
    <Color x:Key="Warning">#ffc107</Color>
    <Color x:Key="Error">#dc3545</Color>
    <Color x:Key="Info">#17a2b8</Color>

</ResourceDictionary>