<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AgilityScoring.Maui.ViewModels"
             x:Class="AgilityScoring.Maui.Views.TournamentDetailPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Tournament Name Label -->
            <Label Text="{Binding TournamentName}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextDark}"
                   HorizontalOptions="Center" />

            <!-- Contestant Navigation Bar -->
            <Border BackgroundColor="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                    <!-- Previous Button -->
                    <Button Grid.Column="0"
                            Text="&#x2190;"
                            FontSize="24"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            WidthRequest="50"
                            HeightRequest="50"
                            Command="{Binding PreviousContestantCommand}"
                            IsEnabled="{Binding CanGoPrevious}" />

                    <!-- Contestant Name (tap to rename) -->
                    <Label Grid.Column="1"
                           Text="{Binding ContestantName}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           TextDecorations="Underline"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRenameContestantClicked" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Next Button -->
                    <Button Grid.Column="2"
                            Text="&#x2192;"
                            FontSize="24"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            WidthRequest="50"
                            HeightRequest="50"
                            Command="{Binding NextContestantCommand}" />

                </Grid>
            </Border>

            <!-- Disqualified Toggle Button -->
            <Button Text="{Binding DisqualifiedButtonText}"
                    Command="{Binding ToggleDisqualifiedCommand}"
                    BackgroundColor="{Binding IsDisqualified, Converter={StaticResource BoolToDisqualifiedColorConverter}}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    Padding="12"
                    CornerRadius="8"
                    Margin="0,0,0,8" />

            <!-- Obstacle Scoring Grid -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    Padding="12">
                <VerticalStackLayout Spacing="4">

                    <!-- Column Headers: obstacle name | R | F -->
                    <Grid ColumnDefinitions="*,104,104" Padding="4,0,4,6">
                        <Label Grid.Column="0" />
                        <Label Grid.Column="1"
                               Text="{Binding [ScoreRefusals], Source={StaticResource Loc}}"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{StaticResource TextMedium}" />
                        <Label Grid.Column="2"
                               Text="{Binding [ScoreFaults], Source={StaticResource Loc}}"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{StaticResource TextMedium}" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource PrimaryLight}" Margin="0,0,0,4" />

                    <!-- One row per obstacle via BindableLayout -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Obstacles}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ObstacleRowViewModel">
                                <Grid ColumnDefinitions="*,104,104" Padding="4,6" ColumnSpacing="4">

                                    <Label Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           VerticalOptions="Center"
                                           FontSize="14"
                                           TextColor="{StaticResource TextDark}" />

                                    <!-- Refusals: - N + -->
                                    <HorizontalStackLayout Grid.Column="1"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           Spacing="2">
                                        <Button Text="-" FontSize="13" WidthRequest="30" HeightRequest="30"
                                                CornerRadius="15" Padding="0"
                                                BackgroundColor="{StaticResource PrimaryLight}" TextColor="White"
                                                Command="{Binding DecrementRefusalsCommand}" />
                                        <Label Text="{Binding Refusals}" WidthRequest="22"
                                               HorizontalTextAlignment="Center" VerticalOptions="Center"
                                               FontSize="14" TextColor="{StaticResource TextDark}" />
                                        <Button Text="+" FontSize="13" WidthRequest="30" HeightRequest="30"
                                                CornerRadius="15" Padding="0"
                                                BackgroundColor="{StaticResource Primary}" TextColor="White"
                                                Command="{Binding IncrementRefusalsCommand}" />
                                    </HorizontalStackLayout>

                                    <!-- Faults: - N + -->
                                    <HorizontalStackLayout Grid.Column="2"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           Spacing="2">
                                        <Button Text="-" FontSize="13" WidthRequest="30" HeightRequest="30"
                                                CornerRadius="15" Padding="0"
                                                BackgroundColor="{StaticResource PrimaryLight}" TextColor="White"
                                                Command="{Binding DecrementFaultsCommand}" />
                                        <Label Text="{Binding Faults}" WidthRequest="22"
                                               HorizontalTextAlignment="Center" VerticalOptions="Center"
                                               FontSize="14" TextColor="{StaticResource TextDark}" />
                                        <Button Text="+" FontSize="13" WidthRequest="30" HeightRequest="30"
                                                CornerRadius="15" Padding="0"
                                                BackgroundColor="{StaticResource Primary}" TextColor="White"
                                                Command="{Binding IncrementFaultsCommand}" />
                                    </HorizontalStackLayout>

                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
