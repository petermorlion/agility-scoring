<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AgilityScoring.Maui.Converters"
             x:Class="AgilityScoring.Maui.Views.SettingsPage"
             xmlns:viewmodels="clr-namespace:AgilityScoring.Maui.ViewModels"
             Title="{Binding Title}">
    
    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="16">
            
            <Label Text="{Binding [Settings], Source={StaticResource Loc}}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextDark}"
                   HorizontalOptions="Center" />

            <!-- Language Section -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    Padding="16"
                    HorizontalOptions="FillAndExpand">
                
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding [Language], Source={StaticResource Loc}}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextDark}" />

                    <Picker Title="{Binding [SelectLanguage], Source={StaticResource Loc}}"
                            ItemsSource="{Binding AvailableLanguages}"
                            SelectedItem="{Binding SelectedLanguage}"
                            HorizontalOptions="FillAndExpand" />

                    <Button Text="{Binding [ChangeLanguage], Source={StaticResource Loc}}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="16"
                            Command="{Binding ChangeLanguageCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Back Button -->
            <Button Text="{Binding [Back], Source={StaticResource Loc}}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    CornerRadius="8"
                    Padding="16"
                    Command="{Binding GoBackCommand}" />

        </VerticalStackLayout>
    </ScrollView>
    
    <ContentPage.Resources>
        <ResourceDictionary />
    </ContentPage.Resources>
</ContentPage>