<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AgilityScoring.Maui.Converters"
             x:Class="AgilityScoring.Maui.Views.IndexPage"
             xmlns:viewmodels="clr-namespace:AgilityScoring.Maui.ViewModels"
             Title="{Binding Title}">
    
    <ContentPage.BindingContext>
        <viewmodels:IndexViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            
            <!-- Header -->
            <Border BackgroundColor="{StaticResource Primary}" 
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    Padding="16" 
                    HorizontalOptions="FillAndExpand">
                
                <VerticalStackLayout>
                    <Label Text="{Binding [AppTitle], Source={StaticResource Loc}}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    
                    <Label Text="{Binding [AppSubtitle], Source={StaticResource Loc}}"
                           FontSize="14"
                           TextColor="{StaticResource PrimaryLight}"
                           HorizontalOptions="Center" />
                    
                    <HorizontalStackLayout HorizontalOptions="End">
                        <Button Text="⚙"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                Command="{Binding NavigateToSettingsCommand}"
                                WidthRequest="40"
                                HeightRequest="40"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Welcome Content -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    Padding="16"
                    HorizontalOptions="FillAndExpand">
                
                <VerticalStackLayout Spacing="16">
                    <Label Text="Dog"
                           FontSize="48"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />
                    
                    <Label Text="{Binding [WelcomeMessage], Source={StaticResource Loc}}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextDark}"
                           HorizontalOptions="Center" />
                    
                    <Label Text="{Binding [WelcomeDescription], Source={StaticResource Loc}}"
                           FontSize="16"
                           TextColor="{StaticResource TextMedium}"
                           HorizontalOptions="Center" />

                    <!-- Go to Tournaments Button -->
                    <Button Text="{Binding [ViewTournaments], Source={StaticResource Loc}}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="16"
                            Command="{Binding NavigateToTournamentsCommand}"
                            HorizontalOptions="FillAndExpand" />

                    <!-- Features -->
                    <VerticalStackLayout Spacing="12" Margin="0,24,0,0">
                        <Label Text="{Binding [AppFeatures], Source={StaticResource Loc}}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextDark}"
                               HorizontalOptions="Center" />

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Trophy"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding [FeatureManage], Source={StaticResource Loc}}"
                                   FontSize="16"
                                   TextColor="{StaticResource TextMedium}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Timer"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding [FeatureTrack], Source={StaticResource Loc}}"
                                   FontSize="16"
                                   TextColor="{StaticResource TextMedium}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Chart"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding [FeatureAnalyze], Source={StaticResource Loc}}"
                                   FontSize="16"
                                   TextColor="{StaticResource TextMedium}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding [PoweredBy], Source={StaticResource Loc}}"
                   FontSize="12"
                   TextColor="{StaticResource TextLight}"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
    
    <ContentPage.Resources>
        <ResourceDictionary />
    </ContentPage.Resources>
</ContentPage>