<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AgilityScoring.Maui.Converters"
             x:Class="AgilityScoring.Maui.Views.LoginPage"
             xmlns:viewmodels="clr-namespace:AgilityScoring.Maui.ViewModels"
             Title="{Binding Title}">
    
    <ContentPage.BindingContext>
        <viewmodels:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="24" VerticalOptions="Center">
            
            <Label Text="Login"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextDark}"
                   HorizontalOptions="Center" />

            <Label Text="Sign in to access your account"
                   FontSize="16"
                   TextColor="{StaticResource TextMedium}"
                   HorizontalOptions="Center" />

            <!-- Google Login Button -->
            <Button Text="Continue with Google"
                    BackgroundColor="White"
                    TextColor="{StaticResource TextDark}"
                    BorderColor="{StaticResource TextLight}"
                    BorderWidth="1"
                    CornerRadius="8"
                    Padding="16"
                    Command="{Binding LoginWithGoogleCommand}"
                    IsEnabled="{Binding IsNotBusy}">
                
                <Button.Content>
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="G"
                               FontSize="20"
                               TextColor="#DB4437"
                               FontAttributes="Bold" />
                        <Label Text="Continue with Google"
                               FontSize="16"
                               TextColor="{StaticResource TextDark}" />
                    </HorizontalStackLayout>
                </Button.Content>
            </Button>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="14"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                              IsVisible="{Binding IsLoading}"
                              Color="{StaticResource Primary}"
                              HorizontalOptions="Center" />

            <!-- Back Button -->
            <Button Text="Back"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    CornerRadius="8"
                    Padding="16"
                    Command="{Binding GoBackCommand}" />

        </VerticalStackLayout>
    </ScrollView>
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:StringToBoolConverter x:Key="StringToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
</ContentPage>