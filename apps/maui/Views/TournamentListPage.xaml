<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AgilityScoring.Maui.Converters"
             x:Class="AgilityScoring.Maui.Views.TournamentListPage"
             xmlns:viewmodels="clr-namespace:AgilityScoring.Maui.ViewModels"
             Title="{Binding Title}">
    
    <ContentPage.BindingContext>
        <viewmodels:TournamentListViewModel />
    </ContentPage.BindingContext>

    <!-- Root Grid: RefreshView fills all space, FAB overlaid -->
    <Grid>
        <RefreshView Command="{Binding LoadTournamentsCommand}" 
                     IsRefreshing="{Binding IsRefreshing}">

            <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="16">

                <!-- Header -->
                <Border Grid.Row="0"
                        BackgroundColor="{StaticResource Primary}" 
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent"
                        Padding="16">
                    <Label Text="{Binding [Tournaments], Source={StaticResource Loc}}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                </Border>

                <!-- Tournaments List — Row="*" gives CollectionView real height -->
                <Border Grid.Row="1"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent"
                        Padding="16">
                    <Grid RowDefinitions="Auto,*">
                        <Label Grid.Row="0"
                               Text="{Binding [Tournaments], Source={StaticResource Loc}}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextDark}" />

                        <CollectionView Grid.Row="1"
                                        Margin="0,8,0,0"
                                        ItemsSource="{Binding Tournaments}"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="{Binding [NoTournaments], Source={StaticResource Loc}}"
                                       FontSize="16"
                                       TextColor="{StaticResource TextLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="{StaticResource PrimaryLight}"
                                            Margin="0,0,0,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TournamentListViewModel}}, Path=SelectTournamentCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextDark}" />
                                            <Label Text="{Binding Date}"
                                                   FontSize="14"
                                                   TextColor="{StaticResource TextMedium}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <Label Grid.Row="2"
                       Text="{Binding [PoweredBy], Source={StaticResource Loc}}"
                       FontSize="12"
                       TextColor="{StaticResource TextLight}"
                       HorizontalOptions="Center" />

            </Grid>
        </RefreshView>

        <!-- Floating Action Button overlaid on same Grid cell -->
        <Button Text="+"
                FontSize="24"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                Command="{Binding NavigateToAddTournamentCommand}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,16,16" />
    </Grid>
</ContentPage>